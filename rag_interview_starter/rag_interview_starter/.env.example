# Choose: ollama or openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local embedding model; no API key required (downloads model on first run)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional reranking
USE_COHERE_RERANK=false
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

CHROMA_PATH=data/chroma
COLLECTION_NAME=rag_interview_demo
DOCUMENTS_PATH=data/documents
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
RERANK_TOP_N=3
